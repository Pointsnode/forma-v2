NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (M3) — never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CRON_SECRET=
# Concierge (M7) — the studio's Anthropic key; paste to enable live model calls.
# Absent → the concierge degrades honestly ("not configured"). Never NEXT_PUBLIC_*.
CONCIERGE_API_KEY=
CONCIERGE_MODEL=claude-haiku-4-5-20251001
# Set the scene (design renders) — the studio's OpenAI key for gpt-image-2 concept images.
# Absent → the "Set the scene" button never renders (feature dark). Server-only, never NEXT_PUBLIC_*.
OPENAI_API_KEY=
# Public site origin (M10) — canonical/OG/sitemap host for the PUBLIC pages. At the
# cutover this flips to the marketing domain (forma.events). Falls back to the Vercel
# URL, then localhost, so previews still build.
NEXT_PUBLIC_SITE_URL=
# Application origin (M12) — where the signed-in app + its OAuth callbacks/webhooks +
# payment/auth returns live. STAYS on app.forma.events across the cutover (the Calendly
# redirect URI + live webhook are pinned there). Unset → falls back to SITE_URL, so no
# change is needed until the runbook sets it explicitly at cutover.
NEXT_PUBLIC_APP_URL=
# Calendar / Calendly (M11) — the OAuth app (Gio creates it in Calendly's dev console)
# + a 32-byte random for app-layer token encryption. Absent → the calendar still shows
# wedding days + due work, with the connect card as the honest empty state. Never
# NEXT_PUBLIC_*. The webhook signing key is stored (encrypted) by the app at
# subscription-create — not an env var.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_TOKEN_ENC_KEY=
